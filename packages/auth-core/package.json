{
  "name": "@naulabs/auth-core",
  "version": "0.0.0",
  "description": "Consumer-agnostic authentication primitives: tokens, password verification, refresh rotation, reset tokens and guards.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/naulabsdotco/nest-platform.git", "directory": "packages/auth-core" },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@naulabs/source": "./src/index.ts",
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.cts", "default": "./dist/cjs/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {"@naulabs/errors":"workspace:*"},
  "peerDependencies": {"@nestjs/common":"^12.0.0","zod":"^4.0.0"},
  "scripts": {
    "prepack": "node ../../scripts/publish-manifest.mjs strip",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  }
}
