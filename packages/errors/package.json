{
  "name": "@naulabsco/errors",
  "version": "0.1.0",
  "description": "Domain and application error taxonomy, fromDomain translation and a pluggable-envelope HTTP filter.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/naulabsdotco/nest-platform.git", "directory": "packages/errors" },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@naulabsco/source": "./src/index.ts",
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.cts", "default": "./dist/cjs/index.js" }
    },
    "./domain": {
      "@naulabsco/source": "./src/domain.ts",
      "import": { "types": "./dist/esm/domain.d.ts", "default": "./dist/esm/domain.js" },
      "require": { "types": "./dist/cjs/domain.d.cts", "default": "./dist/cjs/domain.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": {"@nestjs/common":"^12.0.0"},
  "devDependencies": {"zod":"^4.0.0"},
  "scripts": {
    "prepack": "node ../../scripts/publish-manifest.mjs strip",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  }
}
