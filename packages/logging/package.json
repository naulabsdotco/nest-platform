{
  "name": "@naulabsco/logging",
  "version": "0.2.0",
  "description": "pino logger module with a correlation id and a redaction list a consumer can extend but not empty.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/naulabsdotco/nest-platform.git", "directory": "packages/logging" },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@naulabsco/source": "./src/index.ts",
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.cts", "default": "./dist/cjs/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": {"@nestjs/common":"^12.0.2","nestjs-pino":"^5.2.0","pino":"^10.0.0"},
  "devDependencies": {"@nestjs/microservices":"^12.2.0","pino-http":"^11.0.0"},
  "scripts": {
    "prepack": "node ../../scripts/publish-manifest.mjs strip",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  }
}
