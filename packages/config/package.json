{
  "name": "@naulabs/config",
  "version": "0.0.0",
  "description": "Zod environment loader that parses at boot and never echoes values.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/naulabsdotco/nest-platform.git", "directory": "packages/config" },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@naulabs/source": "./src/index.ts",
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.cts", "default": "./dist/cjs/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": {"@nestjs/common":"^12.0.0","zod":"^4.0.0"},
  "devDependencies": {"@nestjs/core":"^12.0.0","reflect-metadata":"^0.2.0"},
  "scripts": {
    "prepack": "node ../../scripts/publish-manifest.mjs strip",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  }
}
